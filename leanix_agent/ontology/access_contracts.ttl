@prefix ac: <https://knuckles-team.github.io/ontology/access#> .
@prefix : <https://knuckles-team.github.io/ontology/connector/leanix#> .

# Competency read of fact sheets served by leanix_source_factsheets.

:factSheetAccess a ac:AccessContract ;
    ac:classIri :Application ;
    ac:sourceId "leanix-factsheets" ;
    ac:entity "fact_sheet" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "leanix_source_factsheets" ;
    ac:pagination "none" .

:factSheetNameBinding a ac:PropertyBinding ;
    ac:contract :factSheetAccess ; ac:property :name ; ac:field "name" .
:factSheetTypeBinding a ac:PropertyBinding ;
    ac:contract :factSheetAccess ; ac:property :factSheetType ; ac:field "factSheetType" .
